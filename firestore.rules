rules_version = '2';

// SpaceRemind Firestore rules. Supports both private personal spaces (scoped to request.auth.uid)
// and shared households (scoped to household document ownerId or memberEmails).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function owns(resource) {
      return resource.data.ownerId == request.auth.uid;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function canAccessHousehold(householdId) {
      return signedIn()
        && householdId is string
        && exists(householdPath(householdId))
        && (
          get(householdPath(householdId)).data.ownerId == request.auth.uid
          || userEmail() in get(householdPath(householdId)).data.memberEmails
        );
    }

    // Households collection
    match /households/{householdId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || userEmail() in resource.data.memberEmails
      );
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Locations, Places, Items, Reminders, Activity logs
    match /{collection}/{docId} {
      allow read: if signedIn() && (
        resource.data.spaceId == "private_" + request.auth.uid
        || (resource.data.spaceId != null && canAccessHousehold(resource.data.spaceId))
        || (resource.data.spaceId == null && owns(resource)) // fallback compatibility
      );
      allow create: if signedIn() && (
        request.resource.data.spaceId == "private_" + request.auth.uid
        || (request.resource.data.spaceId != null && canAccessHousehold(request.resource.data.spaceId))
      );
      allow update, delete: if signedIn() && (
        resource.data.spaceId == "private_" + request.auth.uid
        || (resource.data.spaceId != null && canAccessHousehold(resource.data.spaceId))
        || (resource.data.spaceId == null && owns(resource))
      );
    }
  }
}
